# AWS Configuration
aws_region = "us-east-1"
project_name = "mdcc-nuvem"
environment = "production"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# RDS Configuration
db_instance_class = "db.t3.micro"
db_allocated_storage = 20
db_name = "mdcc_sd_db"
db_username = "postgres"
db_password = "CHANGE_ME_SECURE_PASSWORD"  # Change this!

# S3 Configuration
s3_bucket_name = "mdcc-nuvem-images-UNIQUE_NAME"  # Must be globally unique

# DynamoDB Configuration
dynamodb_table_name = "crud_logs"

# SQS Configuration
sqs_queue_name = "image-processing-queue"

# Auto Scaling Configuration
min_instances = 1
max_instances = 3
desired_instances = 1
instance_type = "t2.micro"

# Auto Scaling Thresholds
cpu_threshold_scale_up = 70
cpu_threshold_scale_down = 25

# AWS Credentials (for application use)
aws_access_key_id = "YOUR_AWS_ACCESS_KEY_ID"
aws_secret_access_key = "YOUR_AWS_SECRET_ACCESS_KEY"

# Domain Configuration (optional - leave empty to use ALB DNS name directly)
# If you have a domain, configure it here for subdomain-based routing:
# domain_name = "example.com"        # Main domain (e.g., example.com -> frontend)
# api_domain = "api.example.com"     # API subdomain (e.g., api.example.com -> backend)
# If api_domain is empty, it will default to "api.{domain_name}"

# SSH Key Pair Configuration (optional - for SSH access to EC2 instances)
# Create a key pair in AWS EC2 Console first, then specify the name here:
# key_pair_name = "my-key-pair"  # Name of your AWS EC2 Key Pair

# Terraform State Configuration (optional - for S3 backend)
# Uncomment and configure to use S3 backend for Terraform state:
# terraform_state_bucket_name = "mdcc-nuvem-terraform-state-UNIQUE_NAME"  # Must be globally unique
# terraform_state_lock_table_name = "terraform-state-lock"  # DynamoDB table for state locking

